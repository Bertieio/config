{
  "layer": "top",
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["hyprland/window"],
  "modules-right": ["battery","clock", "backlight", "backlight/slider"],
  "hyprland/window": {
    "max-length": 50,
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-icons": {
      "default": ["󰂎 ", "󰁺 ", "󰁻 ", "󰁼 ", "󰁽 ", "󰁾 ", "󰁿 ", "󰂀 ", "󰂁 ", "󰂂 ", "󰁹 "],
      "charging": ["󰢟 ", "󰢜 ", "󰂆 ", "󰂇 ", "󰂈 ", "󰢝 ", "󰂉 ", "󰢞 ", "󰂊 ", "󰂋 ", "󰂅 "]
    },
  },
  "clock": {
    "format": "  {:%H:%M}",
    "format-alt": "{}",
    "tooltip": false,
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{percent}% {icon}",
    "format-icons": ["", ""]
  },
  "backlight/slider": {
    "min": 1,
    "max": 100,
    "orientation": "vertical"
  },
}
